{
	"description": "Initialize claugle rolling quota ledger on SessionStart, emit model routing policy hints on UserPromptSubmit, and record native Claude Code usage from the session transcript on Stop.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claugle.mjs\" hook",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claugle.mjs\" hook",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/claugle.mjs\" hook",
						"timeout": 10
					}
				]
			}
		]
	}
}
